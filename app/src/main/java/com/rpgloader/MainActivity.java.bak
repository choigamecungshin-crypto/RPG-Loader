package com.rpgloader;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.webkit.JavascriptInterface;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.webkit.WebChromeClient;
import android.util.Log;
import android.webkit.ConsoleMessage;
import android.widget.Toast;

import androidx.documentfile.provider.DocumentFile;

import com.rpgloader.GameActivity;

import org.json.JSONArray;
import org.json.JSONObject;

import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.security.MessageDigest;


public class MainActivity extends Activity {
    private boolean hasAllFilesAccess() {
        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.R) {
            return true;
        }
        return android.os.Environment.isExternalStorageManager();
    }

    private void requestAllFilesAccess() {
        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {
            try {
                android.content.Intent intent =
                        new android.content.Intent(
                                android.provider.Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
                                android.net.Uri.parse(
                                        "package:" + getPackageName()
                                )
                        );
                startActivity(intent);
            } catch (Exception e) {
                android.content.Intent intent =
                        new android.content.Intent(
                                android.provider.Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION
                        );
                startActivity(intent);
            }
        }
    }

    private File directGamePathFromTreeUri(String treeUriString) {
        if (!hasAllFilesAccess()) {
            return null;
        }

        try {
            android.net.Uri uri = android.net.Uri.parse(treeUriString);
            String encodedId = uri.getLastPathSegment();

            if (encodedId == null) {
                return null;
            }

            String documentId = android.net.Uri.decode(encodedId);

            if (!documentId.startsWith("primary:")) {
                android.util.Log.e(
                        "RPGLoader",
                        "Only primary external storage is supported: " + documentId
                );
                return null;
            }

            String relativePath = documentId.substring("primary:".length());
            File root = android.os.Environment.getExternalStorageDirectory();
            File gameDir = new File(root, relativePath);

            if (!gameDir.isDirectory()) {
                android.util.Log.e(
                        "RPGLoader",
                        "Game directory does not exist: " + gameDir
                );
                return null;
            }

            File dataWin = new File(gameDir, "data.win");

            if (!dataWin.isFile() || dataWin.length() == 0) {
                android.util.Log.e(
                        "RPGLoader",
                        "data.win not found: " + dataWin
                );
                return null;
            }

            android.util.Log.i(
                    "RPGLoader",
                    "Using game directly: " + gameDir.getAbsolutePath()
            );

            return dataWin;
        } catch (Exception e) {
            android.util.Log.e(
                    "RPGLoader",
                    "Cannot resolve direct game path",
                    e
            );
            return null;
        }
    }


    private static final int REQUEST_CODE_OPEN_DIRECTORY = 1001;
    private WebView webView;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        webView = new WebView(this);
        setContentView(webView);

        WebSettings settings = webView.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        settings.setAllowFileAccess(true);

        webView.addJavascriptInterface(new WebAppInterface(this), "Android");
        webView.setWebViewClient(new WebViewClient());
        webView.setWebChromeClient(new WebChromeClient() {
            @Override
            public boolean onConsoleMessage(ConsoleMessage message) {
                Log.e("RPGLoaderWeb", message.message()
                        + " @" + message.sourceId()
                        + ":" + message.lineNumber());
                return true;
            }
        });
        webView.loadUrl("file:///android_asset/index.html");
    }

    public void selectFolder() {
        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION 
                | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
        startActivityForResult(intent, REQUEST_CODE_OPEN_DIRECTORY);
    }

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (requestCode == REQUEST_CODE_OPEN_DIRECTORY && resultCode == RESULT_OK && data != null) {
            Uri treeUri = data.getData();
            if (treeUri != null) {
                try {
                    getContentResolver().takePersistableUriPermission(
                            treeUri, Intent.FLAG_GRANT_READ_URI_PERMISSION);
                } catch (Exception e) {
                    e.printStackTrace();
                }
                new Thread(() -> {
                    try {
                        String jsonResult = scanSubtreeForDataWin(treeUri);

                        android.util.Log.i(
                                "RPGLoader",
                                "Folder scan result: " + jsonResult
                        );

                        webView.post(() ->
                                webView.evaluateJavascript(
                                        "window.onFolderScanned && window.onFolderScanned("
                                                + jsonResult + ");",
                                        value -> android.util.Log.i(
                                                "RPGLoader",
                                                "JavaScript callback result: " + value
                                        )
                                )
                        );
                    } catch (Exception e) {
                        android.util.Log.e(
                                "RPGLoader",
                                "Folder scan failed",
                                e
                        );

                        webView.post(() ->
                                webView.evaluateJavascript(
                                        "onFolderScanned([])",
                                        null
                                )
                        );
                    }
                }, "RPGLoader-FolderScanner").start();
            }
        }
    }

    private String scanSubtreeForDataWin(Uri treeUri) {
        JSONArray results = new JSONArray();
        DocumentFile rootDir = DocumentFile.fromTreeUri(this, treeUri);
        if (rootDir != null && rootDir.exists()) {
            scanRecursive(rootDir, results, treeUri.toString());
        }
        return results.toString();
    }

    private void scanRecursive(DocumentFile dir, JSONArray results, String treeUriString) {
        if (dir == null || !dir.isDirectory()) return;
        DocumentFile[] files = dir.listFiles();
        for (DocumentFile file : files) {
            if (file.isDirectory()) {
                scanRecursive(file, results, treeUriString);
            } else if (file.isFile() && file.getName() != null) {
                if (file.getName().equalsIgnoreCase("data.win")) {
                    try {
                        JSONObject gameObj = new JSONObject();
                        gameObj.put("uri", file.getUri().toString());
                        gameObj.put("folderUri", treeUriString);
                        gameObj.put("name", file.getName());
                        String parentName = dir.getName();
                        gameObj.put("title", (parentName != null && !parentName.isEmpty()) ? parentName : "Game");
                        gameObj.put("size", file.length());
                        results.put(gameObj);
                    } catch (Exception e) {
                        e.printStackTrace();
                    }
                }
            }
        }
    }

    public class WebAppInterface {
        private final Context mContext;

        WebAppInterface(Context c) {
            mContext = c;
        }

        @JavascriptInterface
        public void openFolderPicker() {
            selectFolder();
        }

    }

    @JavascriptInterface
    public void launchGameFromUri(String uriString, String title, String folderUri) {
            try {
                Uri contentUri = Uri.parse(uriString);
                android.util.Log.i(
                        "RPGLoader",
                        "Launch uri=" + uriString + " folderUri=" + folderUri
                );
                if (!hasAllFilesAccess()) {
                    android.widget.Toast.makeText(
                            MainActivity.this,
                            "Hãy bật quyền truy cập tất cả tệp rồi bấm Play lại",
                            android.widget.Toast.LENGTH_LONG
                    ).show();
                    requestAllFilesAccess();
                    return;
                }

                File localDataWin =
                        directGamePathFromTreeUri(folderUri);

                if (localDataWin == null) {
                    android.widget.Toast.makeText(
                            MainActivity.this,
                            "Không tìm thấy đường dẫn trực tiếp tới data.win",
                            android.widget.Toast.LENGTH_LONG
                    ).show();
                    return;
                }

                File gameRoot = localDataWin.getParentFile();
                File saveDir = new File(gameRoot, "saves");

                if (!saveDir.exists() && !saveDir.mkdirs()) {
                    throw new Exception(
                            "Không tạo được thư mục save: " + saveDir
                    );
                }
                if (localDataWin == null || !localDataWin.exists()) {
                    runOnUiThread(() -> Toast.makeText(MainActivity.this, "Không tìm thấy data.win ở đường dẫn trực tiếp.", Toast.LENGTH_LONG).show());
                    return;
                }

                Intent intent = new Intent(MainActivity.this, GameActivity.class);
                intent.putExtra("EXTRA_DATA_WIN_PATH", localDataWin.getAbsolutePath());
                intent.putExtra("EXTRA_SAVES_PATH", saveDir.getAbsolutePath());
                intent.putExtra("EXTRA_GAME_TITLE", title != null ? title : "Game");
                MainActivity.this.startActivity(intent);
            } catch (Exception e) {
                e.printStackTrace();
                runOnUiThread(() -> Toast.makeText(MainActivity.this, "Lỗi launch game: " + e.getMessage(), Toast.LENGTH_LONG).show());
            }
        }

        private File copyGameFolderToPrivateStorage(
                Uri folderUri,
                String dataWinUri
        ) {
            try {
                String safeHash = Integer.toHexString(dataWinUri.hashCode());

                File gameDir = new File(
                        MainActivity.this.getFilesDir(),
                        "games/" + safeHash
                );

                if (!gameDir.exists() && !gameDir.mkdirs()) {
                    return null;
                }

                DocumentFile sourceDir =
                        DocumentFile.fromTreeUri(MainActivity.this, folderUri);

                if (sourceDir == null || !sourceDir.isDirectory()) {
                    return null;
                }

                File dataWin = new File(gameDir, "data.win");
                File completeMarker = new File(gameDir, ".copy-complete");

                if (completeMarker.exists()
                        && dataWin.exists()
                        && dataWin.length() > 0) {
                    android.util.Log.i(
                            "RPGLoader",
                            "Using cached game: " + gameDir.getAbsolutePath()
                    );
                    return dataWin;
                }

                android.util.Log.i(
                        "RPGLoader",
                        "Copying game files for first launch..."
                );

                copyDocumentTree(sourceDir, gameDir);

                if (!dataWin.exists() || dataWin.length() == 0) {
                    android.util.Log.e(
                            "RPGLoader",
                            "data.win was not copied"
                    );
                    return null;
                }

                try (FileOutputStream out =
                             new FileOutputStream(completeMarker)) {
                    out.write(
                            "complete".getBytes(
                                    java.nio.charset.StandardCharsets.UTF_8
                            )
                    );
                    out.flush();
                }

                android.util.Log.i(
                        "RPGLoader",
                        "Game cache completed: " + gameDir.getAbsolutePath()
                );

                return dataWin;
            } catch (Exception e) {
                e.printStackTrace();
                return null;
            }
        }

        private void copyDocumentTree(
                DocumentFile source,
                File destination
        ) throws Exception {
            if (source == null || !source.exists()) return;

            if (source.isDirectory()) {
                if (!destination.exists() && !destination.mkdirs()) {
                    throw new Exception("Cannot create " + destination);
                }

                for (DocumentFile child : source.listFiles()) {
                    String name = child.getName();
                    if (name == null || name.isEmpty()) continue;

                    File childDestination = new File(destination, name);

                    if (child.isDirectory()) {
                        copyDocumentTree(child, childDestination);
                    } else if (child.isFile()) {
                        if (childDestination.exists()
                                && childDestination.length() == child.length()) {
                            continue;
                        }

                        try (
                                InputStream in =
                                        MainActivity.this.getContentResolver()
                                                .openInputStream(child.getUri());
                                OutputStream out =
                                        new FileOutputStream(childDestination)
                        ) {
                            if (in == null) continue;

                            byte[] buffer = new byte[64 * 1024];
                            int read;

                            while ((read = in.read(buffer)) != -1) {
                                out.write(buffer, 0, read);
                            }

                            out.flush();
                        }
                    }
                }
            }
        }

        private File copyUriToPrivateStorage(Uri uri, String keySource) {
            try {
                MessageDigest md = MessageDigest.getInstance("MD5");
                byte[] digest = md.digest(keySource.getBytes("UTF-8"));
                StringBuilder sb = new StringBuilder();
                for (byte b : digest) {
                    sb.append(String.format("%02x", b));
                }
                String folderHash = sb.toString();

                File gamesDir = new File(MainActivity.this.getFilesDir(), "games/" + folderHash);
                if (!gamesDir.exists()) {
                    gamesDir.mkdirs();
                }
                File destFile = new File(gamesDir, "data.win");

                if (destFile.exists() && destFile.length() > 0) {
                    return destFile;
                }

                InputStream in = MainActivity.this.getContentResolver().openInputStream(uri);
                if (in == null) return null;

                OutputStream out = new FileOutputStream(destFile);
                byte[] buffer = new byte[64 * 1024];
                int read;
                while ((read = in.read(buffer)) != -1) {
                    out.write(buffer, 0, read);
                }
                out.flush();
                out.close();
                in.close();

                return destFile;
            } catch (Exception e) {
                e.printStackTrace();
                return null;
            }
        }
    }
